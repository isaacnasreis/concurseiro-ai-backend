# Backend Environment Variables

# Configurações de Banco de Dados
# Para SQLite local (padrão):
DATABASE_URL=sqlite+aiosqlite:///./concurseiroai.db
# Para PostgreSQL em produção (ex: Render, Railway):
# DATABASE_URL=postgresql+asyncpg://usuario:senha@host:porta/nomedobanco

# Chaves de API (IA)
GEMINI_API_KEY=sua_chave_gemini_aqui

# CORS Origens (Separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
